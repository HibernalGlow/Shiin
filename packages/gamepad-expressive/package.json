{
  "name": "@hibernalglow/gamepad-expressive",
  "version": "1.0.0",
  "description": "Material Design 3 Expressive game controller shapes, vector line-art, icons, and SDL_GameControllerDB mapping standardizer for Xbox, PlayStation, Nintendo, and generic gamepads.",
  "author": "AmagiSakuya",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./src/styles/gamepad-expressive.css",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./shapes": {
      "types": "./dist/shapes/index.d.ts",
      "import": "./dist/shapes/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./detector": {
      "types": "./dist/detector/index.d.ts",
      "import": "./dist/detector/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.3"
  }
}
